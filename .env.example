# Copy this file to `.env` and fill in the values that apply to what you're
# using. Nothing here is required to run the core pipeline (fetch, extract,
# graph); each section is only needed for the corresponding stage.

# --- LLM extraction and chat (wsb extract, wsb entities canonicalize, chat)
# Get one from https://console.anthropic.com — workspace-scoped keys work.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Neo4j (wsb graph push, MCP run_cypher tool)
# Defaults line up with docker-compose.yml. Change if you point at a remote.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=secondbrain

# --- MCP server (wsb mcp, only used by Claude Desktop's config)
# Absolute path to the SQLite file. Only needed because Claude Desktop
# launches the server from an arbitrary working directory.
# WSB_DB=/absolute/path/to/second_brain.db

# --- Hosted site (wsb site build)
# Set at BUILD time; the hash gets baked into index.html. Also set the same
# hash as WSB_SITE_PASSWORD_HASH on your Vercel project so the API rejects
# requests without it. Leave blank to publish without a gate.
# WSB_SITE_PASSWORD=your-shared-passphrase
